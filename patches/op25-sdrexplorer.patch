+
+// slot type: color code (4) + data type (4) + Golay(20,8) parity (12)
+static void encode_slot_type(int cc, int data_type, uint8_t result[20]) {
+	int acc = (cc << 4) | data_type;
+	for (int i=0; i<8; i++)
+		result[i] = (acc >> (7-i)) & 1;
+	for (int j=0; j<12; j++) {
+		int p = 0;
+		for (int i=0; i<8; i++)
+			p ^= result[i] & golay_20_8_parity[i][j];
+		result[8+j] = p;
+	}
+}
