diff --git a/op25/gr-op25_repeater/lib/dmr_ms_tx_bb_impl.cc b/op25/gr-op25_repeater/lib/dmr_ms_tx_bb_impl.cc
new file mode 100644
index 00000000..c842a8d1
--- /dev/null
+++ b/op25/gr-op25_repeater/lib/dmr_ms_tx_bb_impl.cc
@@ -0,0 +1,173 @@
+/* -*- c++ -*- */
+/*
+ * DMR mobile-station voice TX. See dmr_ms_tx_bb_impl.h.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <gnuradio/io_signature.h>
+#include "dmr_ms_tx_bb_impl.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+namespace gr {
+  namespace op25_repeater {
+
+    dmr_ms_tx_bb::sptr
+    dmr_ms_tx_bb::make(int verbose_flag, const char * config_file)
+    {
+      return gnuradio::get_initial_sptr
+        (new dmr_ms_tx_bb_impl(verbose_flag, config_file));
+    }
+
+//////////////////////////////////////////////////////////////////////////
+// in : AMBE codewords (36 dibits, char) on ONE channel (the single logical channel)
+// out: dibits (char, 0..3) in 144-dibit bursts (1 per 30 ms)
+// A mobile-station voice call: [voice LC header] [voice superframes A..F]* [terminator].
+// Voice burst dibit map (same geometry as dmr_bs_tx_bb):
+//   00-11 CACH(12) | 12-47 VC1(36) | 48-65 VC2a(18) | 66-89 mid(24) | 90-107 VC2b(18) | 108-143 VC3(36)
+// The header, terminator, CACH, voice sync and the 4 embedded-LC middle fields are precomputed with
+// full FEC by the Python side and read from the config file; this block interleaves AMBE and sequences
+// the bursts only.
+
+static const int MIN_IN = 1;
+static const int MAX_IN = 1;
+static const int MIN_OUT = 1;
+static const int MAX_OUT = 1;
+
+    dmr_ms_tx_bb_impl::dmr_ms_tx_bb_impl(int verbose_flag, const char * config_file)
+      : gr::block("dmr_ms_tx_bb",
+              gr::io_signature::make(MIN_IN, MAX_IN, 36),
+              gr::io_signature::make(MIN_OUT, MAX_OUT, sizeof(char))),
+        d_verbose_flag(verbose_flag),
+        d_config_file(config_file),
+        d_vc(0),
+        d_preamble(2),             // 2 idle bursts (288 dibits) for the receiver to acquire sync
+        d_headers(2),              // 2 voice LC headers at call start (robust acquisition)
+        d_idle_next(false),
+        d_send_term(false),
+        d_sent_term(false)
+    {
+      memset(d_header, 0, sizeof(d_header));
+      memset(d_term, 0, sizeof(d_term));
+      memset(d_cach, 0, sizeof(d_cach));
+      memset(d_mid, 0, sizeof(d_mid));
+      config();
+      set_output_multiple(144);
+      set_history(3);                 // need >= 3 AMBE codewords for a voice burst
+    }
+
+    dmr_ms_tx_bb_impl::~dmr_ms_tx_bb_impl() {}
+
+    // Config file: a flat binary of dibit bytes (0..3), in order:
+    //   header[144] term[144] cach[12] mid0[24] mid1[24] mid2[24] mid3[24] mid4[24] mid5[24]
+    // = 144+144+12+6*24 = 444 bytes, written by the Python side that builds the bursts.
+    void dmr_ms_tx_bb_impl::config() {
+      FILE * fp = fopen(d_config_file, "rb");
+      if (!fp) {
+        fprintf(stderr, "dmr_ms_tx_bb: cannot open config %s\n", d_config_file);
+        return;
+      }
+      uint8_t buf[444];
+      size_t n = fread(buf, 1, sizeof(buf), fp);
+      fclose(fp);
+      if (n != sizeof(buf)) {
+        fprintf(stderr, "dmr_ms_tx_bb: short config %zu != %zu\n", n, sizeof(buf));
+        return;
+      }
+      size_t p = 0;
+      memcpy(d_header, &buf[p], 144); p += 144;
+      memcpy(d_term,   &buf[p], 144); p += 144;
+      memcpy(d_cach,   &buf[p], 12);  p += 12;
+      for (int i = 0; i < 6; i++) { memcpy(d_mid[i], &buf[p], 24); p += 24; }
+    }
+
+    void dmr_ms_tx_bb_impl::send_terminator() {
+      d_send_term = true;
+    }
+
+    void dmr_ms_tx_bb_impl::forecast(int noutput_items, gr_vector_int &ninput_items_required) {
+      // Only HALF the output bursts are voice (each voice burst is followed by a 144-dibit idle slot);
+      // the idle/header/terminator bursts need no input. Requesting 3 codewords per OUTPUT burst (as if
+      // every burst were voice) over-asks input 2x, so the scheduler blocks waiting for AMBE that is
+      // never consumed -> the vocoder is throttled and voice falls behind (choppy). Request 3 codewords
+      // per VOICE burst only (~nbursts/2). >=1 so the scheduler never stalls on a 0 request.
+      const int nbursts = noutput_items / 144;
+      int reqd = 3 * ((nbursts + 1) / 2);
+      if (reqd < 1) reqd = 1;
+      std::fill(ninput_items_required.begin(), ninput_items_required.end(), reqd);
+    }
+
+    int dmr_ms_tx_bb_impl::general_work(int noutput_items,
+                                        gr_vector_int &ninput_items,
+                                        gr_vector_const_void_star &input_items,
+                                        gr_vector_void_star &output_items) {
+      const uint8_t *in = (const uint8_t *) input_items[0];
+      uint8_t *out = (uint8_t *) output_items[0];
+      int nconsumed = 0;
+      int nout = 0;
+      int bursts = noutput_items / 144;
+
+      for (int n = 0; n < bursts; n++) {
+        // DMR same-slot cadence: every content burst is followed by a 144-dibit idle (the other TDMA
+        // slot). dsd-fme's MS loop reads 144 then skips 144; without the gap its superframe tracking
+        // drifts. The idle also fills the preamble/post-term tail.
+        if (d_idle_next) {
+          memset(out, 0, 144);
+          out += 144; nout += 144;
+          d_idle_next = false;
+          continue;
+        }
+        // 0) idle preamble so the receiver can acquire bit/frame sync before the header
+        if (d_preamble > 0) {
+          memset(out, 0, 144);
+          out += 144; nout += 144;
+          d_preamble--;
+          continue;
+        }
+        if (d_sent_term)
+          break;                       // call ended; nothing more to emit
+        // 1) voice LC header(s) at the start of the call
+        if (d_headers > 0) {
+          memcpy(out, d_header, 144);
+          out += 144; nout += 144;
+          d_headers--;
+          d_idle_next = true;
+          continue;
+        }
+        // 2) terminator (on PTT release), then stop producing
+        if (d_send_term && !d_sent_term) {
+          memcpy(out, d_term, 144);
+          out += 144; nout += 144;
+          d_sent_term = true;
+          d_send_term = false;
+          d_idle_next = true;
+          continue;
+        }
+        // 3) voice burst: needs 3 AMBE codewords
+        if ((ninput_items[0] - nconsumed) < 3)
+          break;
+        const uint8_t *cw = in + nconsumed * 36;   // 3 codewords = 108 dibits (VC1 VC2 VC3)
+        memcpy(&out[0],   d_cach, 12);
+        memcpy(&out[12],  &cw[0], 36);             // VC1
+        memcpy(&out[48],  &cw[36], 18);            // VC2 first half
+        memcpy(&out[66],  d_mid[d_vc], 24);        // sync (A) / embedded LC (B-E) / CC-EMB (F)
+        memcpy(&out[90],  &cw[36 + 18], 18);       // VC2 second half
+        memcpy(&out[108], &cw[36 + 36], 36);       // VC3
+        out += 144; nout += 144;
+        nconsumed += 3;
+        d_vc = (d_vc + 1) % 6;
+        d_idle_next = true;
+      }
+
+      if (nconsumed)
+        consume(0, nconsumed);
+      return nout;
+    }
