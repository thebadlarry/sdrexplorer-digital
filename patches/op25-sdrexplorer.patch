+/* -*- c++ -*- */
+/*
+ * DMR mobile-station voice TX. Emits mobile-station bursts (voice LC header, embedded-LC
+ * voice superframes, terminator) that a repeater's receiver accepts — unlike dmr_bs_tx_bb, which makes
+ * base-station (repeater-output) bursts. The FEC'd constant bursts are precomputed by the Python side
+ * and loaded from the config file; this block does the rate-locked AMBE interleaving.
+ *
+ * This is free software under the GNU General Public License v3 or later; see COPYING.
+ */
+
+#ifndef INCLUDED_OP25_REPEATER_DMR_MS_TX_BB_H
+#define INCLUDED_OP25_REPEATER_DMR_MS_TX_BB_H
+
+#include <gnuradio/op25_repeater/api.h>
+#include <gnuradio/block.h>
+
+namespace gr {
+  namespace op25_repeater {
+
+    /*!
+     * \brief DMR mobile-station voice transmitter (single logical channel).
+     * \ingroup op25_repeater
+     */
+    class OP25_REPEATER_API dmr_ms_tx_bb : virtual public gr::block
+    {
+     public:
+      typedef std::shared_ptr<dmr_ms_tx_bb> sptr;
+
+      static sptr make(int verbose_flag, const char * config_file);
+
+      /*! Append the call terminator (call Python-side on PTT release). */
+      virtual void send_terminator() = 0;
+    };
+
+  } // namespace op25_repeater
+} // namespace gr
+
+#endif /* INCLUDED_OP25_REPEATER_DMR_MS_TX_BB_H */
