+/* -*- c++ -*- */
+/*
+ * DMR mobile-station voice TX. Mirrors dmr_bs_tx_bb but emits
+ * MOBILE-station bursts (what a repeater's receiver accepts): a single logical
+ * channel with a voice LC header, voice superframes carrying the embedded LC,
+ * and a terminator. The constant bursts (header/terminator/embedded-LC middle
+ * fields/sync/CACH) with all their FEC (BPTC(196,96), RS(12,9), Golay(20,8),
+ * QR(16,7,6), BPTC(128,77), Hamming) are precomputed by the Python side
+ * (verified against dsd-fme's decoder) and loaded here as
+ * ready dibit buffers; this block only does rate-locked AMBE interleaving and
+ * burst sequencing (like dmr_bs_tx_bb), so no FEC is reimplemented in C++.
+ */
+
+#ifndef INCLUDED_OP25_REPEATER_DMR_MS_TX_BB_IMPL_H
+#define INCLUDED_OP25_REPEATER_DMR_MS_TX_BB_IMPL_H
+
+#include <gnuradio/op25_repeater/dmr_ms_tx_bb.h>
+#include <stdint.h>
+
+namespace gr {
+  namespace op25_repeater {
+
+    class dmr_ms_tx_bb_impl : public dmr_ms_tx_bb
+    {
+     private:
+      void config(void);
+      int d_verbose_flag;
+      const char * d_config_file;
+      // Precomputed dibit buffers from the config file (all 0..3):
+      uint8_t d_header[144];     // voice LC header data burst
+      uint8_t d_term[144];       // terminator-with-LC data burst
+      uint8_t d_cach[12];        // CACH prefix for every voice burst (single channel)
+      uint8_t d_mid[6][24];      // middle field (24 dibits) per superframe burst A..F:
+                                 //   A = voice sync, B..E = embedded-LC fragments, F = CC-only EMB
+      int d_vc;                  // voice-burst index within the superframe (0..5)
+      int d_preamble;            // idle bursts still to send before the header (receiver sync acquisition)
+      int d_headers;             // voice LC headers still to send at call start
+      bool d_idle_next;          // emit a 144-dibit idle after each content burst (DMR 288-dibit cadence)
+      bool d_send_term;          // set by send_terminator(); the next drained output appends d_term
+      bool d_sent_term;
+
+     public:
+      dmr_ms_tx_bb_impl(int verbose_flag, const char * config_file);
+      ~dmr_ms_tx_bb_impl();
+
+      void send_terminator();    // Python calls this on PTT release to append the call terminator
+
+      void forecast(int noutput_items, gr_vector_int &ninput_items_required);
+      int general_work(int noutput_items,
+                       gr_vector_int &ninput_items,
+                       gr_vector_const_void_star &input_items,
+                       gr_vector_void_star &output_items);
+    };
+
+  } // namespace op25_repeater
+} // namespace gr
+
+#endif /* INCLUDED_OP25_REPEATER_DMR_MS_TX_BB_IMPL_H */
